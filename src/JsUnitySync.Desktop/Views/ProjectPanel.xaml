<UserControl x:Class="JsUnitySync.Desktop.Views.ProjectPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel><StackPanel><TextBlock Text="Team projects" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="The server stores project metadata only; Unity project folders stay on each developer's device." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top"/></DockPanel>
    <TextBlock Text="{Binding Teams.SelectedTeam.Name, TargetNullValue=Select or create a team}" Foreground="{StaticResource BlueBrush}" Margin="0,18,0,8"/>
    <DockPanel IsEnabled="{Binding CanManageTeam}"><TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" MaxLength="96" AutomationProperties.Name="Project name"/><Button Content="Register project" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></DockPanel>
    <TextBlock Text="Projects are visible to team members; only team leads and owners can register, rename or archive them." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
    <CheckBox Content="Include archived projects" IsChecked="{Binding ShowArchived}" Margin="0,12,0,4"/>
   </StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,10,18" Padding="14">
    <StackPanel><TextBlock Text="SHARED PROJECTS" Style="{StaticResource Eyebrow}" Margin="8,0,0,8"/>
     <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="Team projects" MaxHeight="430">
      <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="ARCHIVED" Visibility="{Binding IsArchived, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" FontSize="10"/></DockPanel><TextBlock Text="Revision {Binding Revision}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="10,0,0,18">
    <StackPanel IsEnabled="{Binding IsProjectSelected}">
     <TextBlock Text="PROJECT DETAILS" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Sign in and select a team to view its shared project records." Style="{StaticResource MutedText}" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Text="{Binding SelectedProject.Name}" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding SelectedProject.Revision, StringFormat=Metadata revision {0}}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,18"/>
     <TextBlock Text="Rename on server" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <DockPanel IsEnabled="{Binding CanManageTeam}"><TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" MaxLength="96" AutomationProperties.Name="Rename project"/><Button Content="Save name" Command="{Binding RenameCommand}" Margin="8,0,0,0"/></DockPanel>
     <TextBlock Text="LOCAL UNITY FOLDER (THIS DEVICE ONLY)" Style="{StaticResource Eyebrow}" Margin="0,22,0,8"/>
     <TextBlock Text="{Binding SelectedLocalPath, TargetNullValue=No local folder linked, FallbackValue=No local folder linked}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Local Unity project folder"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="Choose Unity folder…" Click="ChooseFolderClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Unlink folder" Command="{Binding UnlinkCommand}" Margin="0,0,8,8"/><Button Content="Archive server record…" Click="ArchiveProjectClick" IsEnabled="{Binding CanManageTeam}" Visibility="{Binding IsProjectActive, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/><Button Content="Restore server record" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanManageTeam}" Visibility="{Binding IsProjectArchived, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/></WrapPanel>
     <TextBlock Text="SHARED SCRIPT DOCUMENT" Style="{StaticResource Eyebrow}" Margin="0,22,0,8"/>
     <TextBlock Text="Edit a versioned server-side C# document. Saving never writes into your local Unity folder; refresh to inspect another collaborator's latest accepted revision." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBox Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" MaxLength="512" AutomationProperties.Name="Shared script path" Margin="0,0,0,8"/>
     <WrapPanel Margin="0,0,0,8"><Button Content="Load / refresh" Command="{Binding LoadScriptCommand}"/><Button Content="Save shared revision" Command="{Binding SaveScriptCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><TextBlock Text="Revision {Binding ScriptRevision}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
     <TextBox Text="{Binding ScriptContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Height="220" MaxLength="1048576" AutomationProperties.Name="Shared C sharp script editor"/>
     <TextBlock Text="{Binding ScriptMessage}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     <Border Background="{StaticResource AccentSurfaceBrush}" CornerRadius="7" Padding="14" Margin="0,14,0,0"><TextBlock Text="Linking checks only for Assets and ProjectSettings/ProjectVersion.txt. It does not inspect files. Shared script documents live separately on the server, have revision-conflict checks, and are never written into local project files by this editor." Style="{StaticResource MutedText}" FontSize="12"/></Border>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
