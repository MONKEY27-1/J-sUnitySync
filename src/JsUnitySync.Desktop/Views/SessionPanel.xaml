<UserControl x:Class="JsUnitySync.Desktop.Views.SessionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel><StackPanel><TextBlock Text="Collaboration sessions" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Live events are centrally sequenced, stored and replayed after reconnect." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top"/></DockPanel>
    <TextBlock Text="{Binding Projects.SelectedProject.Name, TargetNullValue=Select a project in the Projects panel}" Foreground="{StaticResource BlueBrush}" Margin="0,20,0,9"/>
    <DockPanel IsEnabled="{Binding CanCreateSession}"><TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="New session name"/><Button Content="Create session" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></DockPanel>
    <TextBlock Text="Session membership follows the selected team's project access. A session carries scene events; it does not clone or upload the Unity project." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/>
   </StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,10,18" Padding="14">
    <StackPanel><TextBlock Text="AVAILABLE SESSIONS" Style="{StaticResource Eyebrow}" Margin="8,0,0,8"/><ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" MaxHeight="420" AutomationProperties.Name="Project sessions">
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><DockPanel Margin="0,4,0,0"><TextBlock Text="Last accepted sequence" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding LastSequence}" Foreground="{StaticResource BlueBrush}" DockPanel.Dock="Right"/></DockPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox></StackPanel>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="10,0,0,18">
    <StackPanel>
     <TextBlock Text="{Binding SelectedSession.Name, TargetNullValue=Choose a session}" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding SelectedSession.Id, StringFormat=Session {0}}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,18"/>
     <WrapPanel><Button Content="Connect &amp; receive" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,8,8"/></WrapPanel>
     <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Margin="0,10,0,8"/>
     <TextBlock Text="Locally accepted sequence: {Binding StoredSequence}" Style="{StaticResource MutedText}" FontSize="12"/>
     <TextBlock Text="{Binding StoredEventCount, StringFormat=Protected local event inbox: {0:N0} event(s)}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,14"/>
     <Border Background="{StaticResource AccentSurfaceBrush}" CornerRadius="7" Padding="14"><TextBlock Text="Incoming events are encrypted with Windows DPAPI and acknowledged only after local durable storage. The Unity Editor adapter applies supported Scene/Hierarchy/Inspector events; stale property writes are rejected and surfaced rather than silently overwritten." Style="{StaticResource MutedText}" FontSize="12"/></Border>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
