<UserControl x:Class="JsUnitySync.Desktop.Views.AccountPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
  <StackPanel>
   <TextBlock Text="Account &amp; profile" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="Sign in to the saved backend address. Passwords are never saved on this device." Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
   <StackPanel IsEnabled="{Binding IsIdle}">
    <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}">
     <Label Content="_Email" Target="{Binding ElementName=EmailBox}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,6"/>
     <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Account email"/>
     <Label Content="_Password" Target="{Binding ElementName=PasswordInput}" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0" Padding="0,0,0,6"/>
     <PasswordBox x:Name="PasswordInput" MaxLength="128" Padding="12" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource BlueBrush}" BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="Account password"/>
     <TextBlock Text="New account? Choose a display name and a password of 12–128 characters, then Register." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,6"/>
     <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Registration display name"/>
     <CheckBox Content="Remember this session (Windows-protected)" IsChecked="{Binding RememberSession}" Margin="0,10,0,8"/>
     <WrapPanel>
      <Button Content="Sign in" Click="SignInClick" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
      <Button Content="Register account" Click="RegisterClick"/>
     </WrapPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="{Binding Profile.Email}" Foreground="{StaticResource BlueBrush}" Margin="0,0,0,8"/>
     <TextBlock Text="Share this account ID with teammates to receive invitations:" Style="{StaticResource MutedText}" FontSize="12"/>
     <TextBox Text="{Binding Profile.Id}" IsReadOnly="True" AutomationProperties.Name="Shareable account ID" Margin="0,6,0,12"/>
     <TextBlock Text="Display name" Margin="0,0,0,6"/>
     <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Profile display name"/>
     <WrapPanel Margin="0,14,0,0">
      <Button Content="Save profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
      <Button Content="Refresh profile" Command="{Binding RefreshCommand}" Margin="0,0,10,8"/>
      <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="0,0,0,8"/>
     </WrapPanel>
    </StackPanel>
   </StackPanel>
   <TextBlock Text="Working…" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource PurpleBrush}" Margin="0,12,0,0"/>
   <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Border>
</UserControl>
