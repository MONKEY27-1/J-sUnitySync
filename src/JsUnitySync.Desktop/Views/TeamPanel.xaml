<UserControl x:Class="JsUnitySync.Desktop.Views.TeamPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel><StackPanel><TextBlock Text="Teams &amp; people" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Team membership and friend connections need recipient acceptance." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
     <Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top"/>
    </DockPanel>
    <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}" Margin="0,20,0,0"><TextBlock Text="{Binding SignedOutMessage}" Style="{StaticResource MutedText}"/></StackPanel>
    <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}" Margin="0,22,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,18,0">
      <TextBlock Text="YOUR TEAMS" Style="{StaticResource Eyebrow}"/>
      <ListBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" MaxHeight="190" AutomationProperties.Name="Your teams">
       <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding RoleName}" DockPanel.Dock="Right" Foreground="{StaticResource BlueBrush}"/></DockPanel><TextBlock Text="{Binding MemberCount, StringFormat={}{0} members}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBox Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" ToolTip="Choose a team name" AutomationProperties.Name="New team name" Margin="0,12,0,8"/>
      <Button Content="Create team" Command="{Binding CreateTeamCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      <TextBlock Text="CREATING A TEAM MAKES YOU ITS OWNER." Style="{StaticResource Eyebrow}" FontSize="9" Margin="0,12,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="INVITE A REGISTERED USER" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Use the recipient's account ID. Email addresses are not exposed to team members." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"/>
      <DockPanel><TextBox Text="{Binding InviteUserId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Invite recipient account ID"/><Button Content="Invite" Command="{Binding InviteCommand}" IsEnabled="{Binding CanInviteSelectedTeam}" Margin="8,0,0,0"/></DockPanel>
      <TextBlock Text="MEMBERS" Style="{StaticResource Eyebrow}" Margin="0,20,0,8"/>
      <ItemsControl ItemsSource="{Binding Members}" MaxHeight="140"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5"><DockPanel><Button Content="Change role" DockPanel.Dock="Right" Padding="6,3" FontSize="11" Visibility="{Binding DataContext.CanManageSelectedTeam, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.ChangeRoleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding RoleName}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" Margin="10,0,0,0"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
  <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,10,18">
    <StackPanel><TextBlock Text="TEAM INVITATIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Only your account can accept or decline an invitation." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Invitations}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource RaisedBrush}" CornerRadius="7" Padding="12" Margin="0,4"><StackPanel><TextBlock Text="{Binding TeamName}" FontWeight="SemiBold"/><TextBlock Text="{Binding InviterName, StringFormat=Invited by {0}}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,8"/><WrapPanel><Button Content="Accept" Command="{Binding DataContext.AcceptInvitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="10,6" Margin="0,0,8,0"/><Button Content="Decline" Command="{Binding DataContext.DeclineInvitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="10,6"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="10,0,0,18">
    <StackPanel><TextBlock Text="FRIENDS" Style="{StaticResource Eyebrow}"/><DockPanel><TextBox Text="{Binding FriendUserId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Friend account ID"/><Button Content="Request" Command="{Binding SendFriendRequestCommand}" Margin="8,0,0,0"/></DockPanel>
     <ItemsControl ItemsSource="{Binding Friends}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="INCOMING / OUTGOING REQUESTS" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/>
     <ItemsControl ItemsSource="{Binding FriendRequests}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource RaisedBrush}" CornerRadius="7" Padding="10" Margin="0,3"><StackPanel><DockPanel><TextBlock Text="{Binding OtherDisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Direction}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"/></DockPanel><WrapPanel Margin="0,6,0,0" Visibility="{Binding Incoming, Converter={StaticResource BoolVisibility}}"><Button Content="Accept" Command="{Binding DataContext.AcceptFriendRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0"/><Button Content="Decline" Command="{Binding DataContext.DeclineFriendRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,4"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
