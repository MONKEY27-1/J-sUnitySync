<Window x:Class="JsUnitySync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JsUnitySync.Desktop.Views"
        Title="J'sUnitySync — Development workspace" Width="1320" Height="880" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CheckConnectionCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Sidebar: native window chrome remains intact for OS snapping and accessibility. -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,28,16,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#8250DF" Margin="0,0,10,0">
                            <TextBlock Text="J" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="J'sUnitySync" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="BUILD TOGETHER." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="43,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="16,0,0,12" Foreground="{StaticResource MutedBrush}"/>
                    <ListBox x:Name="NavigationList" AutomationProperties.AutomationId="NavigationList" AutomationProperties.Name="Workspace navigation"
                             ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             KeyboardNavigation.TabNavigation="Once">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,13,0" VerticalAlignment="Center" Foreground="{StaticResource PurpleBrush}"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="LOCAL WORKSPACE" Style="{StaticResource Eyebrow}" FontSize="10"/>
                        <TextBlock Text="{Binding Account.AccountLabel}" FontWeight="SemiBold"/>
                        <Button Content="Account &amp; profile" Command="{Binding OpenSettingsCommand}" Padding="6" Margin="0,10,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,17">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Workspace" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " Foreground="{StaticResource BorderBrush}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedPage.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="5" Padding="10,5">
                        <TextBlock Text="UNITY COLLABORATION WORKSPACE" FontSize="10" Foreground="{StaticResource PurpleBrush}"/>
                    </Border>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,28,30,28" Focusable="False">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedPage.Eyebrow}" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding SelectedPage.Title}" FontSize="32" FontWeight="SemiBold" AutomationProperties.AutomationId="PageTitle"/>
                    <TextBlock Text="{Binding SelectedPage.Description}" Style="{StaticResource MutedText}" Margin="0,8,0,26" FontSize="15"/>

                    <!-- Real overview: no fake accounts, projects, activity or participant counts. -->
                    <StackPanel x:Name="OverviewPanel" Style="{StaticResource AnimatedSection}" Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,22" Padding="28">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#282039"/><GradientStop Color="#151D2A" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="YOUR NEXT GREAT BUILD STARTS HERE" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="Your team. Your scene.&#10;One shared direction." FontSize="27" FontWeight="SemiBold" LineHeight="36"/>
                                    <TextBlock Text="Work together on shared Scenes, versioned scripts and synchronized assets. Select your project to begin." Style="{StaticResource MutedText}" Margin="0,16,0,20"/>
                                    <Button Content="Configure workspace →" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#111520" BorderBrush="#3B3656" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="BACKEND API" Style="{StaticResource Eyebrow}" Foreground="{StaticResource BlueBrush}"/>
                                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="21" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SavedServerAddress}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,12"/>
                                        <Button x:Name="OverviewCheckButton" Content="Check API  ·  F5" Command="{Binding CheckConnectionCommand}" AutomationProperties.AutomationId="OverviewCheckButton"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="Explore your workspace" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Built for the way Unity teams work. Open a panel to see its availability." Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding WorkspacePages}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding NavigateCommand}" Padding="20" Margin="0,0,12,12" HorizontalContentAlignment="Stretch" Background="{StaticResource PanelBrush}" AutomationProperties.Name="{Binding Title}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PurpleBrush}" FontSize="19"/>
                                                <TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,7"/>
                                            <TextBlock Text="{Binding Availability}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <views:SessionPanel x:Name="SessionPanel" DataContext="{Binding SessionWorkspace}" Visibility="{Binding DataContext.IsSessions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                    <views:TeamPanel x:Name="TeamPanel" DataContext="{Binding TeamWorkspace}" Visibility="{Binding DataContext.IsTeam, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                    <views:ProjectPanel x:Name="ProjectPanel" DataContext="{Binding ProjectWorkspace}" Visibility="{Binding DataContext.IsProjects, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>

                    <StackPanel x:Name="WorkspacePanel" Style="{StaticResource AnimatedSection}" Visibility="{Binding IsWorkspace, Converter={StaticResource BoolVisibility}}">
                        <views:HistoryPanel DataContext="{Binding ProjectWorkspace}"/>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Style="{StaticResource AnimatedSection}" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}">
                        <views:AccountPanel DataContext="{Binding Account}"/>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Backend connection" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Use HTTPS for remote servers. Local development may use HTTP on loopback." Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
                                <Label Target="{Binding ElementName=ServerAddressBox}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,8" Content="_Server address"/>
                                <TextBox x:Name="ServerAddressBox" AutomationProperties.AutomationId="ServerAddressBox" AutomationProperties.Name="Server address"
                                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048"/>
                                <TextBlock Text="Checks always use the saved address below. Save first to switch servers." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,22"/>
                                <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ReduceMotionCheckBox" Content="_Reduce motion" IsChecked="{Binding ReduceMotion}" AutomationProperties.AutomationId="ReduceMotionCheckBox"/>
                                <TextBlock Text="Disables panel fades. Windows animation preferences are also respected." Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,20"/>
                                <Button x:Name="SaveSettingsButton" Content="Save _preferences" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveSettingsButton"/>
                                <TextBlock Text="{Binding SettingsMessage}" Style="{StaticResource MutedText}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Shared diagnostics panel is visible on every page. -->
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text=" · API readiness only" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConnectionMessage}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,6"/>
                                <TextBlock Text="{Binding SavedServerAddress}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="CheckApiButton" Content="Check _API" Command="{Binding CheckConnectionCommand}" AutomationProperties.AutomationId="CheckApiButton" ToolTip="Check backend readiness (F5)"/>
                                <Button Content="_Cancel check" Command="{Binding CancelCheckCommand}" Visibility="{Binding CheckConnectionCommand.IsRunning, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <TextBlock Text="J'SUNITYSYNC · UNITY COLLABORATION" Foreground="{StaticResource PurpleBrush}" FontSize="10"/>
                <TextBlock Text=" · No collaboration session connected" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock DockPanel.Dock="Right" Text="F5  Check API     Ctrl+,  Settings" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
